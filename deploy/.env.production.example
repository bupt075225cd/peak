# 生产部署环境变量模板。复制为 .env.production 并填入真实值后使用，
# 该文件含敏感信息，勿提交到仓库。
# 用法：复制本文件与 docker-compose.prod.yml、deploy/prometheus.yml 到部署机
# 同一目录，在 .env.production 同目录执行：
#   docker compose --env-file .env.production -f docker-compose.prod.yml pull
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d

# ── 镜像版本 ────────────────────────────────────────────
# CI 每次推送 main 都会打 commit sha tag；不填默认 latest
IMAGE_TAG=latest

# ── 认证 ────────────────────────────────────────────────
# JWT 密钥，生产必须强随机（示例生成：openssl rand -base64 48）
JWT_SECRET=

# ── MySQL ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=

# ── 对象存储（S3 兼容，双桶）────────────────────────────
# 注意：必须使用「区域级通用端点」（如七牛 http://s3.cn-east-1.qiniucs.com），
# 不要用桶级专用域名（如 <bucket>.s3.cn-east-1.qiniucs.com）——
# 桶级域名会忽略路径中的桶名，导致双桶隔离失效、所有写入落到同一桶。
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# recognition-service 专用桶（transient/ 临时区）
S3_RECOGNITION_BUCKET=
# question-service 专用桶（committed/ 正式区）
S3_QUESTION_BUCKET=

# ── 识别服务 provider ───────────────────────────────────
# aliyun（OCR+VLM）/ zhipu；按所选 provider 填对应密钥
RECOGNITION_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_SECRET=
ALIYUN_OCR_ENDPOINT=
ALIYUN_DASH_KEY=
ALIYUN_DASH_MODEL=qwen-vl-max
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-5.3-flash

# ── 可观测性 ────────────────────────────────────────────
# 链路追踪：指向编排内 Tempo 的 OTLP gRPC 端口（留空则关闭追踪，本地开发友好）。
TRACING_ENDPOINT=tempo:4317
# Grafana 管理员（必填，无默认密码；首次启动后写入数据卷，之后改此值不再生效）。
# 访问方式：Grafana 仅绑定主机 127.0.0.1，需经 SSH 隧道访问：
#   ssh -L 3001:127.0.0.1:3001 root@<host>
# 然后浏览器打开 http://127.0.0.1:3001 并用以下账号登录。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Grafana 主机侧端口（默认 3001，被占用时改此值）。
# GRAFANA_PORT=3001
# 数据库连接池（可选，按流量调整；默认 25/10）。
# DB_MAX_OPEN_CONNS=50
# DB_MAX_IDLE_CONNS=10
# DB_SLOW_QUERY_THRESHOLD=200ms
